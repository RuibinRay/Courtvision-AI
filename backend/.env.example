# Copy to backend/.env — never commit real keys. The frontend never sees these values.
COURTVISION_ALLOWED_ORIGINS=http://localhost:8765,https://YOUR-USER.github.io
COURTVISION_REFRESH_TOKEN=change-me-long-random-string
# Optional: enables the language-model assistant (tool-calling over the calculation layer)
ANTHROPIC_API_KEY=
COURTVISION_ASSISTANT_MODEL=claude-sonnet-5-5
# Optional alternate provider
BALLDONTLIE_API_KEY=
COURTVISION_LIVE_CACHE_SECONDS=20
